{
  "name": "dsh-visible-action-row",
  "version": "0.2.0",
  "description": "DSH (web and desktop) plugin: keep every message's action row — copy/like/dislike/branch controls, timestamp, and third-party additions — always visible without hovering",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "web",
    "ui",
    "action-row"
  ],
  "homepage": "https://github.com/Bobnemimimmi/dsh-visible-action-row#readme",
  "bugs": {
    "url": "https://github.com/Bobnemimimmi/dsh-visible-action-row/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bobnemimimmi/dsh-visible-action-row.git"
  },
  "license": "MIT",
  "author": "Bobnemimimmi <haoran020924@gmail.com>",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "prepare": "node build.mjs",
    "prepack": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node build.mjs && vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
